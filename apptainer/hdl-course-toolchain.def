# Apptainer image for the HDL course toolchain.
#
# The SIF is derived from the OCI image built by Containerfile; it does not
# maintain a second installation recipe. Build it with `make sif`.

Bootstrap: docker-archive
From: {{ARCHIVE}}

%labels
    org.opencontainers.image.title       hdl-course-toolchain
    org.opencontainers.image.description Reproducible HDL/EDA course toolchain
    toolchain.derived-from                Containerfile
    toolchain.versions                    versions.yml

%environment
    # Apptainer ignores the OCI ENTRYPOINT, so source the canonical runtime
    # environment explicitly instead of restating PATH here.
    . /etc/profile.d/hdl-course-toolchain.sh

%runscript
    exec "$@"

%test
    /opt/toolchain/bin/toolchain-doctor
