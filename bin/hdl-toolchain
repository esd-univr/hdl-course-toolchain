#!/usr/bin/env bash
# Run a command inside the course toolchain image against a mounted workspace.
#
# Docker and Apptainer are intentionally normalized here: both get an isolated
# root environment, no network by default, and one writable workspace at /work.
set -euo pipefail

# A misspelled HDL_TOOLCHAIN_* variable used to be ignored in silence, so a
# request for one engine could run in the other and still report success.
# Anything unrecognised is refused instead.
known_env="HDL_TOOLCHAIN_IMAGE HDL_TOOLCHAIN_TAG HDL_TOOLCHAIN_ENGINE HDL_TOOLCHAIN_SIF HDL_TOOLCHAIN_QUIET"
for name in $(env | sed -n 's/^\(HDL_TOOLCHAIN_[A-Z0-9_]*\)=.*/\1/p'); do
    case " ${known_env} " in
        *" ${name} "*) ;;
        *)
            echo "error: unknown environment variable ${name}" >&2
            echo "       recognised: ${known_env}" >&2
            exit 2
            ;;
    esac
done

IMAGE="${HDL_TOOLCHAIN_IMAGE:-hdl-course-toolchain}"
TAG="${HDL_TOOLCHAIN_TAG:-latest}"
ENGINE="${HDL_TOOLCHAIN_ENGINE:-docker}"
SIF="${HDL_TOOLCHAIN_SIF:-.out/hdl-course-toolchain.sif}"
WORKSPACE=""
ALLOW_NETWORK="no"

usage() {
    cat >&2 <<'EOF_USAGE'
usage: hdl-toolchain [options] -- COMMAND [ARGS...]

  --workspace DIR   host directory to mount at /work (required)
  --engine ENGINE   docker (default) or apptainer
  --sif PATH        SIF to use with --engine apptainer
  --network         allow network access (denied by default, both engines)

Environment: HDL_TOOLCHAIN_IMAGE, HDL_TOOLCHAIN_TAG, HDL_TOOLCHAIN_ENGINE, HDL_TOOLCHAIN_SIF.
EOF_USAGE
    exit 2
}

while [ $# -gt 0 ]; do
    case "$1" in
        --workspace) WORKSPACE="${2:?--workspace needs a directory}"; shift 2 ;;
        --engine)    ENGINE="${2:?--engine needs a name}";             shift 2 ;;
        --sif)       SIF="${2:?--sif needs a path}";                   shift 2 ;;
        --network)   ALLOW_NETWORK="yes";                              shift ;;
        --)          shift; break ;;
        -h|--help)   usage ;;
        *)           echo "error: unknown option: $1" >&2; usage ;;
    esac
done

[ -n "${WORKSPACE}" ] || { echo "error: --workspace is required" >&2; usage; }
[ $# -gt 0 ]          || { echo "error: no command given" >&2; usage; }
[ -d "${WORKSPACE}" ] || { echo "error: no such directory: ${WORKSPACE}" >&2; exit 2; }
WORKSPACE="$(cd "${WORKSPACE}" && pwd)"

# Say exactly what is about to run. A doctor PASS is only meaningful together
# with the identity of the artifact it inspected: a tag can still point at an
# older image, and a SIF can predate the sources it was supposed to be built
# from. Both failures are silent without this line.
identify() {
    [ -z "${HDL_TOOLCHAIN_QUIET:-}" ] || return 0
    case "${ENGINE}" in
        docker)
            digest=$(docker image inspect "${IMAGE}:${TAG}" \
                        --format '{{.Id}}' 2>/dev/null || echo "<not built>")
            created=$(docker image inspect "${IMAGE}:${TAG}" \
                        --format '{{.Created}}' 2>/dev/null | cut -c1-19)
            printf '[hdl-toolchain] docker %s:%s %s built %s\n' \
                "${IMAGE}" "${TAG}" "${digest#sha256:}" "${created:-?}" >&2
            ;;
        apptainer)
            built=$(date -r "${SIF}" '+%Y-%m-%dT%H:%M:%S' 2>/dev/null || echo "?")
            printf '[hdl-toolchain] apptainer %s built %s\n' "${SIF}" "${built}" >&2
            ;;
    esac
}
identify

SCRATCH="${WORKSPACE}/.toolchain"
mkdir -p \
    "${SCRATCH}/tmp" \
    "${SCRATCH}/cache" \
    "${SCRATCH}/config" \
    "${SCRATCH}/data" \
    "${SCRATCH}/state"

runtime_env=(
    --env TMPDIR=/work/.toolchain/tmp
    --env XDG_CACHE_HOME=/work/.toolchain/cache
    --env XDG_CONFIG_HOME=/work/.toolchain/config
    --env XDG_DATA_HOME=/work/.toolchain/data
    --env XDG_STATE_HOME=/work/.toolchain/state
)

case "${ENGINE}" in
docker)
    network=(--network none)
    [ "${ALLOW_NETWORK}" = "no" ] || network=()
    tty=()
    [ -t 0 ] && [ -t 1 ] && tty=(-t)
    exec docker run --rm -i "${tty[@]}" \
        "${network[@]}" \
        --read-only \
        --hostname toolchain \
        --tmpfs /tmp:rw,nosuid,nodev,exec \
        --tmpfs /var/tmp:rw,nosuid,nodev \
        --user "$(id -u):$(id -g)" \
        --mount "type=bind,source=${WORKSPACE},target=/work" \
        --workdir /work \
        --env HOME=/work \
        "${runtime_env[@]}" \
        "${IMAGE}:${TAG}" "$@"
    ;;
apptainer)
    if [ ! -f "${SIF}" ]; then
        echo "error: no SIF at ${SIF}; run 'make sif' first" >&2
        exit 2
    fi
    network=(--net --network none)
    [ "${ALLOW_NETWORK}" = "no" ] || network=()
    exec apptainer exec \
        --containall \
        "${network[@]}" \
        --home "${WORKSPACE}:/work" \
        --pwd /work \
        "${runtime_env[@]}" \
        "${SIF}" "$@"
    ;;
*)
    echo "error: unknown engine: ${ENGINE} (expected docker or apptainer)" >&2
    exit 2
    ;;
esac
